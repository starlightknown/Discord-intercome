# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Intercom
INTERCOM_TOKEN=your_intercom_api_token_here

# Storage (use Google Sheets for production)
USE_LOCAL_STORAGE=false
GOOGLE_SHEETS_ID=your_google_sheets_id_here
GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# Slack Bot
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CHANNEL=your_slack_channel_id

# Discord Channel IDs
FEEDBACK_CHANNEL_ID=your_feedback_channel_id
MOD_CHANNEL_ID=your_mod_channel_id
PUBLIC_DASHBOARD_CHANNEL_ID=your_public_dashboard_channel_id

# Semantic Similarity (optional)
SEMANTIC_URL=http://localhost:5000

# Server
PORT=10000
